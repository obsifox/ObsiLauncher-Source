    <!-- 1.5.0 ویزارد استارتاپ -->
    <string name="wizard_welcome_title">به ObsiLauncher خوش آمدید</string>
    <string name="wizard_welcome_body">یک لانچر ماینکرافت رایگان و متن‌باز برای اندروید — بدون کلید دسترسی و بدون قابلیت قفل‌شده. چهار قدم کوتاه تا شروع بازی.</string>
    <string name="wizard_start">شروع کنیم</string>
    <string name="wizard_bg_title">بک‌گراند خود را انتخاب کنید</string>
    <string name="wizard_bg_hint">دو نوع بک‌گراند ساخته شده — هر زمان بخواهید از تنظیمات ← بک‌گراند عوضش کنید.</string>
    <string name="wizard_bg_video">ویدیوی زنده</string>
    <string name="wizard_bg_video_desc">تریلر داخل خود برنامه است: یک بار پخش می‌شود، والپیپر ۴۵ ثانیه روی صفحه می‌ماند و بعد دوباره ویدیو پخش می‌شود — چرخه‌ی بی‌پایان. فقط آخرین نسخه‌ی ماینکرافت ویدیو دارد — بقیه‌ی نسخه‌ها خودکار والپیپرشان را نشان می‌دهند.</string>
    <string name="wizard_bg_wallpaper">والپیپرهای رسمی</string>
    <string name="wizard_bg_wallpaper_desc">هر نسخه والپیپر رسمی خودش را از minecraft.net می‌گیرد و رنگ‌بندی لانچر با آن هماهنگ می‌شود (Obsi Dynamic).</string>
    <string name="wizard_next">بعدی</string>
    <string name="wizard_account_title">پروفایل بازیکن شما</string>
    <string name="wizard_account_body">همین حالا یک پروفایل آفلاین رایگان بسازید — به اکانت مایکروسافت نیازی نیست. بعداً می‌توانید از بخش اکانت‌ها اکانت مایکروسافت اضافه کنید.</string>
    <string name="wizard_account_existing">پروفایل موجود: %1$s</string>
    <string name="wizard_account_error">نام باید ۳ تا ۱۶ حرف، عدد یا _ باشد</string>
    <string name="wizard_done_title">همه چیز آماده است!</string>
    <string name="wizard_done_body">از تب نسخه‌ها یک نسخه نصب کنید و دکمه‌ی Play را بزنید. خوش بگذرد!</string>
    <string name="wizard_enter">ورود به ObsiLauncher</string>

