    <!-- 1.5.0 setup wizard -->
    <string name="wizard_welcome_title">Welcome to ObsiLauncher</string>
    <string name="wizard_welcome_body">A free, open-source Minecraft launcher for Android — no access keys, no locked features. Four quick steps and you are in.</string>
    <string name="wizard_start">Get started</string>
    <string name="wizard_bg_title">Pick your background</string>
    <string name="wizard_bg_hint">Two background types are built in — you can switch any time in Settings → Background.</string>
    <string name="wizard_bg_video">Live video</string>
    <string name="wizard_bg_video_desc">The official trailer plays muted behind the launcher. Only the latest Minecraft release gets the video — other versions automatically show their wallpaper.</string>
    <string name="wizard_bg_wallpaper">Official wallpapers</string>
    <string name="wizard_bg_wallpaper_desc">Every version gets its official minecraft.net artwork and the launcher recolors itself to match it (Obsi Dynamic).</string>
    <string name="wizard_next">Next</string>
    <string name="wizard_account_title">Your player profile</string>
    <string name="wizard_account_body">Create a free offline profile now — no Microsoft account needed. You can add a Microsoft account later in Accounts.</string>
    <string name="wizard_account_existing">Existing profile: %1$s</string>
    <string name="wizard_account_error">Name must be 3–16 letters, digits or _</string>
    <string name="wizard_done_title">You are all set!</string>
    <string name="wizard_done_body">Install a version in the Versions tab, then hit Play. Have fun!</string>
    <string name="wizard_enter">Enter ObsiLauncher</string>

